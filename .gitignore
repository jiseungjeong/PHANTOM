# App-generated data directory
Data/
_unused_external/

# Offline analysis workspace.
# Track source & docs (scripts, README, requirements), but ignore
# regenerable heavy artifacts (datasets, trained models, reports, caches).
# The deployed KNN references are bundled separately at iOS/Resources/knn_params*.json.
analysis/**/*.json
analysis/**/*.joblib
analysis/**/*.csv
analysis/**/*.svg
analysis/**/*.png
analysis/**/reports/
analysis/**/_*_tmp/
analysis/**/__pycache__/

# Exception: curated presentation figures (small, the actual deliverable).
# Verification grids and other regenerable PNGs stay ignored under reports/.
!analysis/**/figures/
!analysis/**/figures/*.png
# but DO track the small model_metadata.json (config + validation metrics record;
# tiny, useful for reproducing/comparing model runs)
!analysis/**/model_metadata.json

# Reference papers / docs dumped at repo root
*.pdf

# Large generated media at repo root (demo recordings / GIFs — regenerable, too big for git)
*.gif
*.mov
*.mp4
# Logo source at root is redundant (the app icon lives in iOS/Assets.xcassets/AppIcon)
/app-logo.png

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
